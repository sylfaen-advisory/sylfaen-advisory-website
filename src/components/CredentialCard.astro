---
/**
 * Shared credential card (Credentials section, and later service pages).
 * Body copy goes in the default slot. Badges render as plain text links
 * to the issuer's verification page.
 */
import type { Badge } from '../data/credentials';

interface Props {
  glyph: string;
  /** Superscript after the glyph, e.g. "+" in "15+". */
  glyphSuffix?: string;
  /** Set the glyph in the mono face (used for acronyms such as ISO, CMI). */
  glyphMono?: boolean;
  title: string;
  tags?: string[];
  badges?: Badge[];
}
const { glyph, glyphSuffix, glyphMono = false, title, tags = [], badges = [] } = Astro.props;
---
<div class="cred">
  <div class="cred-glyph">
    {glyphMono
      ? <span class="cred-glyph-mono">{glyph}</span>
      : <>{glyph}{glyphSuffix && <span class="small">{glyphSuffix}</span>}</>}
  </div>
  <div class="cred-title">{title}</div>
  {Astro.slots.has('default') && <p class="cred-body"><slot /></p>}
  {tags.length > 0 && (
    <ul class="cred-list">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  )}
  {badges.length > 0 && (
    <ul class="badge-list">
      {badges.map((b) => (
        <li><a href={b.href} target="_blank" rel="noopener">
          <span class="badge-name">{b.name}</span>
          <span class="badge-issuer">{b.issuer}</span>
          <span class="badge-verify">{b.verify} &#8599;</span>
        </a></li>
      ))}
    </ul>
  )}
</div>

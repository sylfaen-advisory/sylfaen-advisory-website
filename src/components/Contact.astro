<section class="section section-rule" id="contact">
  <div class="wrap">
    <div class="contact">
      <div class="contact-aside">
        <div class="eyebrow" style="margin-bottom: 20px;"><span class="num">05</span>Contact</div>
        <h2 class="section-title">
          Begin with a <em>conversation</em> &mdash; no pitch, no commitment.
        </h2>
        <p class="section-sub" style="margin-top: 24px;">
          We respond to every enquiry within one business day. Initial
          conversations are scoped at 30 minutes and held under
          confidentiality by default.
        </p>

        <div class="principal-card">
          <div class="principal-photo">
            <img src="/assets/headshot-mark.jpg" alt="Mark Biscoe, Principal of Sylfaen Advisory" />
          </div>
          <div class="principal-meta">
            <span class="principal-eyebrow">You&rsquo;ll speak with</span>
            <span class="principal-name">Mark Biscoe</span>
            <span class="principal-role">Principal &middot; Engagement lead</span>
            <span class="principal-bio">
              Fifteen years&rsquo; CDE delivery across health, infrastructure and
              housebuilding. ISO 19650-native practitioner.
            </span>
          </div>
        </div>

        <div class="contact-modes">
          <a href="mailto:mark@sylfaenadvisory.co.uk" class="contact-mode">
            <span class="ix">i.</span>
            <span class="lbl">
              <span class="t">mark@sylfaenadvisory.co.uk</span>
              <span class="s">Direct to engagement lead &middot; typical reply in &lt; 4h</span>
            </span>
            <span class="arr">&rarr;</span>
          </a>
          <a href="#form-name" class="contact-mode">
            <span class="ix">ii.</span>
            <span class="lbl">
              <span class="t">Submit a brief</span>
              <span class="s">Structured intake form &middot; ten minutes</span>
            </span>
            <span class="arr">&rarr;</span>
          </a>
          <a href="https://calendly.com/mark-sylfaenadvisory/30min" target="_blank" rel="noopener noreferrer" class="contact-mode">
            <span class="ix">iii.</span>
            <span class="lbl">
              <span class="t">Book a 30-minute introduction</span>
              <span class="s">Wed &amp; Thu afternoons &middot; Teams or in-person, Cardiff / London</span>
            </span>
            <span class="arr">&rarr;</span>
          </a>
        </div>
      </div>

      <form class="form-card" action="https://formspree.io/f/mqejaqpg" method="POST">
        <div class="form-head">
          <span class="t">Engagement enquiry</span>
        </div>

        <input type="hidden" name="_subject" value="Sylfaen Advisory — website enquiry" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row split">
          <div class="form-row" style="border-bottom: none;">
            <label for="form-name">Name</label>
            <input id="form-name" name="name" placeholder="Your name" required />
          </div>
          <div class="form-row" style="border-bottom: none;">
            <label for="form-org">Organisation</label>
            <input id="form-org" name="organisation" placeholder="Company or asset owner" />
          </div>
        </div>

        <div class="form-row">
          <label for="form-email">Email</label>
          <input id="form-email" type="email" name="email" placeholder="you@example.co.uk" required />
        </div>

        <div class="form-row" style="border-bottom: none;">
          <label for="form-interest">Interested in</label>
          <select id="form-interest" name="interested_in">
            <option>Health Check (Tier I)</option>
            <option>Implementation (Tier II)</option>
            <option>Retainer (Tier III)</option>
            <option>AI Governance Advisory (Tier IV)</option>
            <option>Awen demo</option>
            <option>Not sure yet</option>
          </select>
        </div>

        <div class="form-row">
          <label for="form-msg">Context</label>
          <textarea id="form-msg" name="context" placeholder="A sentence or two on the project, platform, or problem in scope."></textarea>
        </div>

        <div class="form-foot">
          <span class="note">Held in confidence by default &middot; NDAs available on request.</span>
          <button type="submit" class="btn btn-primary">
            Send enquiry <span class="arrow">&rarr;</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
